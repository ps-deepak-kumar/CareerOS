# ─── Microsoft Azure App Registration (M365 Work Intelligence) ───────────────
# Leave as-is for demo/simulation mode — no real credentials needed
VITE_MICROSOFT_CLIENT_ID=your-client-app-id-here
VITE_MICROSOFT_TENANT_ID=common

# ─── AI Provider Keys (Phase 1) ───────────────────────────────────────────────
# OpenRouter — Free at https://openrouter.ai (Claude 3.5 Sonnet for highest complexity tasks)
VITE_OPENROUTER_API_KEY=your-openrouter-key-here

# Groq — Free at https://console.groq.com (no credit card — Llama 3.1 70B, very fast)
VITE_GROQ_API_KEY=your-groq-key-here

# Google Gemini — Free at https://aistudio.google.com (Gemini 1.5 Flash, large context)
VITE_GEMINI_API_KEY=your-gemini-key-here

# Ollama local base URL (optional — defaults to http://localhost:11434)
# Run: ollama serve && ollama pull llama3
VITE_OLLAMA_BASE_URL=http://localhost:11434

# ─── External Data APIs (Phase 4) ─────────────────────────────────────────────
# YouTube Data API v3 — Free at https://console.cloud.google.com
# Enable "YouTube Data API v3", create API key under "Credentials"
# Free quota: 10,000 units/day
VITE_YOUTUBE_API_KEY=your-youtube-api-key-here

# GitHub Personal Access Token — Free at https://github.com/settings/tokens
# Scopes needed: none (public repo read only) — rate limit: 5000 req/hour
VITE_GITHUB_TOKEN=your-github-token-here

# Adzuna Job Search API — Free at https://developer.adzuna.com
# Free tier: 250 calls/month, no credit card needed
VITE_ADZUNA_APP_ID=your-adzuna-app-id
VITE_ADZUNA_APP_KEY=your-adzuna-app-key
